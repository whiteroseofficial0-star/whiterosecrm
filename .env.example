# Copy to .env and fill in. Never commit the real .env.

# MongoDB (Prisma needs a replica set for transactions).
# Local single-node replica set:
#   mongod --dbpath .localdb --port 27018 --bind_ip 127.0.0.1 --replSet rs0
DATABASE_URL="mongodb://127.0.0.1:27018/whiterose?replicaSet=rs0"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="change-me"

# Public base URL of the app.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
